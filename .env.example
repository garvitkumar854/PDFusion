# ── Google AdSense (optional; the app runs fine without these) ──────────────
# Your AdSense publisher ID. Accepts "ca-pub-1234567890123456" or the bare
# digits. The site's own ID is already the default in src/lib/adsense.ts;
# override it here (set to "" to disable ads).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Ad-unit slot IDs (AdSense → Ads → By ad unit → "ad slot" id).
# HOME shows between the hero and the tool grid on the homepage.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
# CONTENT shows above the footer on every page.
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
